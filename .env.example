# ReflectAI – environment variables
# Copy this file to ".env" and fill in your real keys.
# Never commit your actual .env file to git!

# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Paystack (Nigeria & Africa — https://dashboard.paystack.com/#/settings/developer)
# PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
# PAYSTACK_PLAN_CODE=PLN_xxxxxxxx

# Stripe (International — https://dashboard.stripe.com/apikeys)
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_PRICE_ID=price_xxxxxxxx        # Recurring $5/month price from Stripe dashboard
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx  # From Stripe dashboard → Webhooks

# Public URL of your deployed app (used for Stripe redirect URLs)
# APP_URL=https://your-domain.com

# Admin secret for /api/admin/users (auto-generated if not set)
# ADMIN_SECRET=pick_any_strong_random_string

# Optional: change the port the server listens on (default: 3000)
# PORT=3000
